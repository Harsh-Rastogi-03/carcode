# carcode settings. Copy to .env (./carcode setup does this) and edit.

# Folder that holds your git repos. Claude Code runs here.
CARCODE_WORKDIR=~/code

# What the assistant is called (you'll say "Hey Siri, <name>") and how it addresses you.
CARCODE_NAME=Jarvis
CARCODE_USER_TITLE=Boss
# Spoken when the shortcut starts. Defaults to "Hello <title>, I am ready for work."
# CARCODE_GREETING=

# Dictation language for the shortcut, e.g. en-US, en-GB, en-IN, en-AU.
CARCODE_LANGUAGE=en-US

# Optional: pin the GitHub CLI to one account (see: gh auth status).
CARCODE_GH_USER=

# Optional: extra tools Claude may use without asking, comma separated
# (e.g. mcp__my_server to allow a whole MCP server).
CARCODE_EXTRA_TOOLS=

# Optional: push a phone notification when a long task finishes (install the ntfy app).
NTFY_TOPIC=

# Advanced
# CARCODE_WAIT_SECONDS=8      # max seconds before replying "One moment"
# CARCODE_JOB_TIMEOUT=900     # stop a single task after this many seconds
# CARCODE_LABEL=dev.carcode   # launchd label prefix
# PORT=8787
